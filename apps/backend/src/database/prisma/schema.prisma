  qcInspector   String?        @map("qc_inspector")
  items         AssetGRPOItem[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("asset_grpos")
}

model AssetGRPOItem {
  id              String    @id @default(uuid())
  grpoId          String    @map("grpo_id")
  grpo            AssetGRPO @relation(fields: [grpoId], references: [id], onDelete: Cascade)
  poLineRef       Int       @map("po_line_ref")
  description     String
  orderedQty      Int       @map("ordered_qty")
  receivedQty     Int       @map("received_qty")
  acceptedQty     Int       @map("accepted_qty")
  rejectedQty     Int       @map("rejected_qty")
  rejectionReason String?   @map("rejection_reason")
  condition       String
  serialNo        String?   @map("serial_no")
  assetTag        String?   @map("asset_tag")
  batchNo         String?   @map("batch_no")
  remarks         String?

  @@map("asset_grpo_items")
}

model AssetAPInvoice {
  id                  String               @id @default(uuid())
  invoiceNo           String               @unique @map("invoice_no")
  vendorInvoiceNo     String               @map("vendor_invoice_no")
  vendorInvoiceDate   DateTime             @map("vendor_invoice_date")
  postingDate         DateTime             @default(now()) @map("posting_date")
  dueDate             DateTime             @map("due_date")
  poNo                String               @map("po_no")
  grpoNo              String               @map("grpo_no")
  vendorCode          String               @map("vendor_code")
  vendorName          String               @map("vendor_name")
  vendorGstin         String               @map("vendor_gstin")
  vendorPan           String               @map("vendor_pan")
  address             String               @db.Text
  companyGstin        String               @map("company_gstin")
  companyPan          String               @map("company_pan")
  placeOfSupply       String               @map("place_of_supply")
  irn                 String?
  qrCodeRef           String?              @map("qr_code_ref")
  currency            String               @default("INR")
  exchangeRate        Decimal              @default(1.00) @map("exchange_rate")
  taxableAmount       Decimal              @map("taxable_amount")
  totalCgst           Decimal              @map("total_cgst")
  totalSgst           Decimal              @map("total_sgst")
  totalIgst           Decimal              @map("total_igst")
  totalCess           Decimal              @default(0.00) @map("total_cess")
  totalTax            Decimal              @map("total_tax")
  freight             Decimal              @default(0.00)
  discount            Decimal              @default(0.00)
  otherCharges        Decimal              @default(0.00) @map("other_charges")
  loadingCharges      Decimal              @default(0.00) @map("loading_charges")
  unloadingCharges    Decimal              @default(0.00) @map("unloading_charges")
  packingCharges      Decimal              @default(0.00) @map("packing_charges")
  insurance           Decimal              @default(0.00)
  isInterState        Boolean              @default(false) @map("is_inter_state")
  applyGst            Boolean              @default(true) @map("apply_gst")
  chargeGstStates     Json?                @map("charge_gst_states")
  paymentMode         String?              @map("payment_mode")
  paymentTerms        String?              @map("payment_terms")
  termsBlock          String?              @map("terms_block")
  supplierQuoteRef    String?              @map("supplier_quote_ref")
  roundOff            Decimal              @default(0.00) @map("round_off")
  invoiceTotal        Decimal              @map("invoice_total")
  amountInWords       String               @map("amount_in_words")
  tdsAmount           Decimal              @default(0.00) @map("tds_amount")
  netPayable          Decimal              @map("net_payable")
  bankName            String               @map("bank_name")
  bankAccountHolder   String               @map("bank_account_holder")
  bankAccountNo       String               @map("bank_account_no")
  bankIfsc            String               @map("bank_ifsc")
  bankBranch          String               @map("bank_branch")
  bankUpi             String?              @map("bank_upi")
  paymentInstructions String?              @map("payment_instructions")
  lateInterestClause  String?              @map("late_interest_clause")
  contactQuery        String?              @map("contact_query")
  signatoryBlock      String?              @map("signatory_block")
  status              String               @default("Open")
  items               AssetAPInvoiceItem[]
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@map("asset_ap_invoices")
}

model AssetAPInvoiceItem {
  id              String         @id @default(uuid())
  invoiceId       String         @map("invoice_id")
  invoice         AssetAPInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  lineNo          Int            @map("line_no")
  itemCode        String         @map("item_code")
  description     String
  hsnCode         String         @map("hsn_code")
  uom             String
  quantity        Int
  unitPrice       Decimal        @map("unit_price")
  discountPercent Decimal        @default(0.00) @map("discount_percent")
  taxableValue    Decimal        @map("taxable_value")
  gstRate         Decimal        @map("gst_rate")
  cgst            Decimal
  sgst            Decimal
  igst            Decimal
  cess            Decimal        @default(0.00)
  lineTotal       Decimal        @map("line_total")

  @@map("asset_ap_invoice_items")
}

model Asset {
  id                     String    @id @default(uuid())
  assetId                String    @unique @map("asset_id")
  assetName              String    @map("asset_name")
  description            String    @db.Text
  category               String
  subCategory            String?   @map("sub_category")
  manufacturer           String?
  modelNo                String?   @map("model_no")
  serialNo               String    @unique @map("serial_no")
  barcode                String?
  purchaseDate           DateTime  @map("purchase_date")
  capitalizationDate     DateTime  @map("capitalization_date")
  purchaseCost           Decimal   @map("purchase_cost")
  incidentalCosts        Decimal   @default(0.00) @map("incidental_costs")
  capitalizedCost        Decimal   @map("capitalized_cost")
  usefulLife             Int       @map("useful_life")
  depreciationMethod     String    @default("SLM") @map("depreciation_method")
  depreciationRate       Decimal   @map("depreciation_rate")
  monthlyDepreciation    Decimal   @map("monthly_depreciation")
  accumulatedDepreciation Decimal   @default(0.00) @map("accumulated_depreciation")
  bookValue              Decimal   @map("book_value")
  salvageValue           Decimal   @map("salvage_value")
  location               String
  assignedTo             String?   @map("assigned_to")
  assignedToEmpId        String?   @map("assigned_to_emp_id")
  department             String
  costCenter             String    @map("cost_center")
  status                 String    @default("Active")
  vendorName             String?   @map("vendor_name")
  vendorCode             String?   @map("vendor_code")
  poNo                   String?   @map("po_no")
  invoiceNo              String?   @map("invoice_no")
  warrantyExpiry         DateTime? @map("warranty_expiry")
  amcStart               DateTime? @map("amc_start")
  amcEnd                 DateTime? @map("amc_end")
  insurancePolicyNo      String?   @map("insurance_policy_no")
  insuranceExpiry        DateTime? @map("insurance_expiry")
  nextMaintenance        DateTime? @map("next_maintenance")
  disposalDate           DateTime? @map("disposal_date")
  disposalMethod         String?   @map("disposal_method")
  disposalProceeds       Decimal?  @map("disposal_proceeds")
  disposalGainLoss       Decimal?  @map("disposal_gain_loss")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("assets")
}

model DepartmentBudget {
  id         String   @id @default(uuid())
  department String   @unique
  fiscalYear String   @map("fiscal_year")
  allocated  Decimal
  utilized   Decimal
  remaining  Decimal
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("department_budgets")
}

model AssetMaster {
  id             String   @id @default(uuid())
  assetName      String   @unique @map("asset_name")
  category       String
  hsnCode        String   @map("hsn_code")
  hsnDescription String?  @map("hsn_description")
  specifications String?  @db.Text
  lastUnitCost   Decimal? @map("last_unit_cost")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("asset_masters")
}

model CommunicationLog {
  id           String   @id @default(uuid())
  documentType String   // PR, PQ, PO, GRPO, AP_INVOICE, SALES_INVOICE
  documentNo   String
  recipient    String
  channel      String   // EMAIL, WHATSAPP
  status       String   // SENT, FAILED, SKIPPED
  subject      String?
  content      String?  @db.Text
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([documentNo, documentType])
  @@map("communication_logs")
}

model CompanyDetails {
  id             String   @id @default(uuid())
  companyName    String   @map("company_name")
  companyAddress String   @db.Text @map("company_address")
  companyGstin   String   @map("company_gstin")
  companyPan     String   @map("company_pan")
  companyMobile  String   @map("company_mobile")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("company_details")
}

model SalesCampaign {
  id                 String                      @id @default(uuid())
  name               String
  productId          String                      @map("product_id")
  targetQuantity     Decimal                     @map("target_quantity")
  price              Decimal                     @map("price")
  minDepositPercent  Decimal                     @default(0) @map("min_deposit_percent")
  startDate          DateTime                    @map("start_date")
  endDate            DateTime                    @map("end_date")
  status             String                      @default("Active") // Active, Completed
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  
  product            FinishedProduct             @relation(fields: [productId], references: [id])
  preOrders          SalesCampaignOrder[]

  @@map("sales_campaigns")
}

model SalesCampaignOrder {
  id             String                      @id @default(uuid())
  campaignId     String                      @map("campaign_id")
  customerName   String                      @map("customer_name")
  quantity       Decimal
  depositPaid    Decimal                     @map("deposit_paid")
  balanceDue     Decimal                     @map("balance_due")
  status         String                      @default("Booked") // Booked, Fulfilled, Delivered
  createdAt      DateTime                    @default(now()) @map("created_at")
  
  campaign       SalesCampaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("sales_campaign_orders")
}

model SalesReturn {
  id             String                      @id @default(uuid())
  returnNo       String                      @unique @map("return_no") // SR-XXXXXX
  invoiceId      String                      @map("invoice_id") // Links to CustomerOrder (representing invoice)
  reason         String
  refundMethod   String                      @map("refund_method") // Cash, Credit Note, Replacement
  status         String                      @default("Completed")
  createdAt      DateTime                    @default(now()) @map("created_at")
  
  order          CustomerOrder               @relation(fields: [invoiceId], references: [id])
  items          SalesReturnItem[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id            String                       @id @default(uuid())
  returnId      String                       @map("return_id")
  productId     String                       @map("product_id")
  quantity      Decimal
  condition     String                       // Resaleable, Damaged, Destroyed
  
  return        SalesReturn                  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  product       FinishedProduct              @relation(fields: [productId], references: [id])

  @@map("sales_return_items")
}

model ErrorLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  userRole  String?  @map("user_role")
  message   String   @db.Text
  stack     String?  @db.Text
  path      String
  method    String
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("error_logs")
}

enum RMQuotationStatus {
  DRAFT
  SENT
  PARTIALLY_RESPONDED
  ALL_RESPONDED
  EXPIRED
  CONVERTED
}

enum RMQuotationSupplierStatus {
  PENDING
  RESPONDED
  RESUBMISSION_REQUESTED
  EXPIRED
  EMAIL_FAILED
}

model RMQuotation {
  id            String              @id @default(uuid())
  quotationNo   String              @unique @map("quotation_no")
  quotationDate DateTime            @default(now()) @map("quotation_date")
  expiryAt      DateTime            @map("expiry_at")
  note          String?             @db.Text
  status        RMQuotationStatus   @default(SENT)
  createdBy     String              @map("created_by")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  creator       User                @relation(fields: [createdBy], references: [id])
  items         RMQuotationItem[]
  suppliers     RMQuotationSupplier[]

  @@map("rm_quotations")
}

model RMQuotationItem {
  id            String              @id @default(uuid())
  quotationId   String              @map("quotation_id")
  materialId    String              @map("material_id")
  materialName  String              @map("material_name")
  materialCode  String?             @map("material_code")
  quantity      Decimal
  unit          String
  gstApplicable Boolean             @default(true) @map("gst_applicable")
  gstRate       Decimal             @default(18.00) @map("gst_rate")

  quotation     RMQuotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  material      RawMaterial         @relation(fields: [materialId], references: [id])
  responseItems RMQuotationResponseItem[]

  @@map("rm_quotation_items")
}

model RMQuotationSupplier {
  id            String                    @id @default(uuid())
  quotationId   String                    @map("quotation_id")
  supplierId    String                    @map("supplier_id")
  supplierEmail String                    @map("supplier_email")
  secureToken   String                    @unique @map("secure_token")
  status        RMQuotationSupplierStatus @default(PENDING)
  sentAt        DateTime                  @default(now()) @map("sent_at")
  respondedAt   DateTime?                 @map("responded_at")

  quotation     RMQuotation               @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier      Supplier                  @relation(fields: [supplierId], references: [id])
  responses     RMQuotationResponse[]

  @@map("rm_quotation_suppliers")
}

model RMQuotationResponse {
  id                  String                  @id @default(uuid())
  quotationSupplierId String                  @map("quotation_supplier_id")
  discount            Decimal                 @default(0.00)
  shipping            Decimal                 @default(0.00)
  otherCharges        Decimal                 @default(0.00) @map("other_charges")
  supplierNote        String?                 @db.Text @map("supplier_note")
  subtotal            Decimal                 @default(0.00)
  taxTotal            Decimal                 @default(0.00) @map("tax_total")
  grandTotal          Decimal                 @default(0.00) @map("grand_total")
  submittedAt         DateTime                @default(now()) @map("submitted_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  quotationSupplier   RMQuotationSupplier     @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)
  items               RMQuotationResponseItem[]

  @@map("rm_quotation_responses")
}

model RMQuotationResponseItem {
  id              String             @id @default(uuid())
  responseId      String             @map("response_id")
  quotationItemId String             @map("quotation_item_id")
  unitPrice       Decimal            @default(0.00) @map("unit_price")
  gstRate         Decimal            @default(0.00) @map("gst_rate")
  lineSubtotal    Decimal            @default(0.00) @map("line_subtotal")

  response        RMQuotationResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  quotationItem   RMQuotationItem     @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@map("rm_quotation_response_items")
}