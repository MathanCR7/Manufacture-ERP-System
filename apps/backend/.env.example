# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/erp_manufacture?schema=public&connection_limit=50"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/erp_manufacture?schema=public&connection_limit=50"

# JWT Secret Key for token signing
JWT_SECRET="generate_a_secure_random_jwt_secret_key_here"

# Server Port (default 5000)
PORT=5000

# Allowed Frontend URL(s)
FRONTEND_URL="https://erp.leonex.net"

# Public App URL for links in emails and QR codes
PUBLIC_APP_URL="https://erp.leonex.net"

# SMTP Mail Settings for notification alerts
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_app_password"
